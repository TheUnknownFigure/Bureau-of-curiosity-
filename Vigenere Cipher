# Vigenere Cipher
# Key: OBSESSION

KEY = "OBSESSION"

def  (text):
    result = ""
    key_index = 0

    for char in text:
        if char.isalpha():
            shift = ord(KEY[key_index % len(KEY)].upper()) - ord('A')

            if char.isupper():
                result += chr((ord(char)-65 + shift) % 26 + 65)
            else:
                result += chr((ord(char)-97 + shift) % 26 + 97)

            key_index += 1
        else:
            result += char

    return result


def vigenere_decrypt(text):
    result = ""
    key_index = 0

    for char in text:
        if char.isalpha():
            shift = ord(KEY[key_index % len(KEY)].upper()) - ord('A')

            if char.isupper():
                result += chr((ord(char)-65 - shift) % 26 + 65)
            else:
                result += chr((ord(char)-97 - shift) % 26 + 97)

            key_index += 1
        else:
            result += char

    return result


